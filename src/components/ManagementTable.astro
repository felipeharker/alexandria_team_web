---
// A management table (management/*.mdx): one CSV file shown as a table, in the hub's own table (.ax-chart, as the
// supplier pages'). The files are in the private alexandria_office repo, public/management/, since this repository
// is public and they hold the office's own records; the gate serves them at /management/<file> to people who are
// signed in. The page reads its file in the browser each time it opens, so an edit pushed to alexandria_office
// shows up within two minutes, with no hub deploy.
//
// The table shows whatever columns the file has, in the file's order, and finds the ones it treats specially by
// their header (the management pages give each file's columns, and /management/ the rules they share):
// the first column names the row; Status, Priority, Current account and Migrated are shown as tags; Start, Due and
// Target are dates; Description and Notes get room to wrap.
interface Props {
	/** the file's name in alexandria_office's public/management/, such as accounts.csv */
	file: string;
	/** what's counted over the table: the rows whose `column` starts with `is`, as "3 of 11 <label>" */
	done: { column: string; is: string; label: string };
	/** also count the rows by this column's other values, such as Status */
	tally?: string;
}
const { file, done, tally = '' } = Astro.props;
---

<div
	class="ax-manage not-content"
	data-file={file}
	data-done-column={done.column}
	data-done-is={done.is}
	data-done-label={done.label}
	data-tally={tally}
>
	<div class="ax-manage-progress" hidden>
		<div class="ax-manage-bar"><span></span></div>
		<output></output>
	</div>
	<div class="ax-chart" hidden>
		<label class="ax-chart-find">
			<span>Find</span>
			<input type="search" placeholder="Any word in a row" autocomplete="off" spellcheck="false" />
			<output aria-live="polite"></output>
		</label>
		<div class="ax-chart-scroll">
			<table>
				<thead><tr></tr></thead>
				<tbody></tbody>
			</table>
		</div>
	</div>
	<p class="ax-manage-note" role="status">Loading the table…</p>
</div>

<script>
	// Rows of cells from CSV text: commas (or semicolons, if that's what the header row uses), "quoted" cells that
	// may hold commas, line breaks and "" for a quote. Blank rows are dropped.
	function parseCsv(text: string): string[][] {
		const firstLine = text.slice(0, text.search(/[\r\n]|$/));
		const comma = !firstLine.includes(',') && firstLine.includes(';') ? ';' : ',';
		const rows: string[][] = [];
		let row: string[] = [];
		let cell = '';
		let quoted = false;
		for (let i = 0; i < text.length; i++) {
			const c = text[i];
			if (quoted) {
				if (c !== '"') cell += c;
				else if (text[i + 1] === '"') (cell += '"'), i++;
				else quoted = false;
			} else if (c === '"' && cell === '') quoted = true;
			else if (c === comma) (row.push(cell), (cell = ''));
			else if (c === '\n' || c === '\r') {
				if (c === '\r' && text[i + 1] === '\n') i++;
				row.push(cell);
				rows.push(row);
				row = [];
				cell = '';
			} else cell += c;
		}
		if (cell !== '' || row.length) (row.push(cell), rows.push(row));
		return rows.map((cells) => cells.map((value) => value.trim())).filter((cells) => cells.some(Boolean));
	}

	// The file's text: UTF-8 (with or without Excel's mark at the start), or Excel's older plain "CSV" save.
	function decode(bytes: ArrayBuffer): string {
		try {
			return new TextDecoder('utf-8', { fatal: true }).decode(bytes);
		} catch {
			return new TextDecoder('windows-1252').decode(bytes);
		}
	}

	// A date as the standard writes it, 2026-12-04, also when Excel has rewritten it as 12/4/2026.
	function isoDate(value: string): string {
		const us = value.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
		return us ? `${us[3]}-${us[1].padStart(2, '0')}-${us[2].padStart(2, '0')}` : value;
	}

	const TAGS = /^(status|priority|current account|migrated\b.*)$/;
	const DATES = /^(start|due|target|date)$/;
	const WIDE = /^(description|notes)$/;
	const GOOD = /^(y|yes|done|company|shipped|complete|completed)$/;
	const WARN = /^(n|no|personal|waiting|blocked|on hold|urgent)$/;
	const ACTIVE = /^(doing|in progress|partial|high)$/;
	const tone = (value: string) => {
		const v = value.toLowerCase();
		return GOOD.test(v) ? 'good' : WARN.test(v) ? 'warn' : ACTIVE.test(v) ? 'active' : '';
	};

	async function show(box: HTMLElement) {
		const note = box.querySelector<HTMLElement>('.ax-manage-note')!;
		const chart = box.querySelector<HTMLElement>('.ax-chart')!;
		const { file = '', doneColumn = '', doneIs = '', doneLabel = '', tally = '' } = box.dataset;
		let rows: string[][];
		try {
			const res = await fetch(`/management/${file}`, { cache: 'no-store' });
			if (!res.ok) throw new Error(String(res.status));
			rows = parseCsv(decode(await res.arrayBuffer()).replace(/^﻿/, ''));
			if (!rows.length) throw new Error('empty');
		} catch {
			note.textContent = `${file} couldn’t be read. Refresh the page; if it stays like this, the file is missing or empty.`;
			return;
		}
		const columns = rows[0];
		const body = rows.slice(1).map((cells) => columns.map((_, i) => cells[i] ?? ''));
		const keys = columns.map((column) => column.toLowerCase());
		const at = (name: string) => keys.findIndex((key) => key === name.toLowerCase() || key.startsWith(`${name.toLowerCase()} `));
		const doneAt = at(doneColumn);
		const isDone = (cells: string[]) => doneAt >= 0 && cells[doneAt].toLowerCase().startsWith(doneIs.toLowerCase());
		const today = new Date(Date.now() - new Date().getTimezoneOffset() * 60000).toISOString().slice(0, 10);

		const head = box.querySelector('thead tr')!;
		for (const column of columns) head.append(Object.assign(document.createElement('th'), { textContent: column }));

		const tbody = box.querySelector('tbody')!;
		const trs: HTMLTableRowElement[] = [];
		for (const cells of body) {
			const tr = document.createElement('tr');
			tr.dataset.find = cells.join(' ').toLowerCase();
			cells.forEach((value, i) => {
				const td = document.createElement('td');
				if (i === 0) td.className = 'name';
				else if (WIDE.test(keys[i])) td.className = 'wide';
				if (TAGS.test(keys[i]) && value) {
					const tag = Object.assign(document.createElement('span'), { textContent: value });
					tag.className = `ax-tag ${tone(value)}`.trim();
					td.append(tag);
				} else if (DATES.test(keys[i])) {
					const date = isoDate(value);
					td.className = 'date';
					td.textContent = date;
					// past its Due or Target and not done yet
					if (/^(due|target)$/.test(keys[i]) && /^\d{4}-\d\d-\d\d$/.test(date) && date < today && !isDone(cells)) {
						td.classList.add('late');
						td.title = 'Past this date';
					}
				} else td.textContent = value;
				tr.append(td);
			});
			tbody.append(tr);
			trs.push(tr);
		}

		// the count over the table: "3 of 11 moved to the company email", then the other values of the tally column
		const progress = box.querySelector<HTMLElement>('.ax-manage-progress')!;
		const total = body.length;
		const finished = body.filter(isDone).length;
		let words = `${finished} of ${total} ${doneLabel}`;
		const tallyAt = tally ? at(tally) : -1;
		if (tallyAt >= 0) {
			const counts = new Map<string, number>();
			for (const cells of body) {
				const value = cells[tallyAt];
				if (value && !isDone(cells)) counts.set(value, (counts.get(value) ?? 0) + 1);
			}
			// in the order the work moves, then anything else as the file has it
			const order = ['doing', 'next', 'waiting', 'later', 'inbox'];
			const place = (value: string) => (order.indexOf(value.toLowerCase()) + 1 || order.length + 1);
			for (const [value, count] of [...counts].sort((a, b) => place(a[0]) - place(b[0]))) words += ` · ${count} ${value.toLowerCase()}`;
		}
		progress.querySelector('output')!.textContent = words;
		progress.querySelector<HTMLElement>('.ax-manage-bar span')!.style.width = total ? `${(finished / total) * 100}%` : '0';
		progress.hidden = false;

		// the Find box, as on a supplier's chart: the rows holding every word typed
		const input = box.querySelector('input')!;
		const count = box.querySelector('.ax-chart-find output')!;
		const all = `${total} ${total === 1 ? 'row' : 'rows'}`;
		count.textContent = all;
		input.addEventListener('input', () => {
			const typed = input.value.toLowerCase().split(/\s+/).filter(Boolean);
			let shown = 0;
			for (const tr of trs) {
				const hit = typed.every((word) => (tr.dataset.find || '').includes(word));
				tr.hidden = !hit;
				if (hit) shown += 1;
			}
			count.textContent = typed.length ? `${shown} of ${total}` : all;
		});

		chart.hidden = false;
		note.hidden = true;
	}

	for (const box of document.querySelectorAll<HTMLElement>('.ax-manage')) show(box);
</script>
