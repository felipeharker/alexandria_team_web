---
// The drawing at the top of each tool's card on the home page: what the tool makes, drawn as a plain line drawing in
// the hub's greys (theme.css, "the tool cards"), so a tool reads at a glance. One drawing per `name`, all on the same
// 320 × 180 sheet. The Parametric Grid's, the Image Grid's and Alexandria Phoenix's cells are worked out here, the
// way those tools work them out, so they're true to what the tools make.
interface Props {
	name: string;
}
import { etchText } from '../etchFont';

const { name } = Astro.props;

const r1 = (v: number) => Math.round(v * 10) / 10;
const SQRT3 = Math.sqrt(3);
type Pt = [number, number];

/** Pointy-top hexes of side s whose whole cell fits in the box: their centres. */
function hexCentres(s: number, x0: number, y0: number, x1: number, y1: number): Pt[] {
	const out: Pt[] = [];
	const w = SQRT3 * s;
	for (let j = 0, cy = y0 + s; cy + s <= y1; j++, cy += 1.5 * s) {
		for (let cx = x0 + w / 2 + (j % 2 ? w / 2 : 0); cx + w / 2 <= x1; cx += w) out.push([cx, cy]);
	}
	// centred in the box
	const xs = out.map((p) => p[0]), ys = out.map((p) => p[1]);
	const dx = (x0 + x1 - (Math.min(...xs) + Math.max(...xs))) / 2, dy = (y0 + y1 - (Math.min(...ys) + Math.max(...ys))) / 2;
	return out.map(([x, y]) => [x + dx, y + dy]);
}
const hexPath = ([cx, cy]: Pt, s: number) => {
	const w = (SQRT3 / 2) * s;
	const p: Pt[] = [[cx, cy - s], [cx + w, cy - s / 2], [cx + w, cy + s / 2], [cx, cy + s], [cx - w, cy + s / 2], [cx - w, cy - s / 2]];
	return `M${p.map(([x, y]) => `${r1(x)} ${r1(y)}`).join('L')}z`;
};
const circlePath = ([cx, cy]: Pt, r: number) => `M${r1(cx - r)} ${r1(cy)}a${r1(r)} ${r1(r)} 0 1 0 ${r1(2 * r)} 0a${r1(r)} ${r1(r)} 0 1 0 ${r1(-2 * r)} 0z`;
const clamp01 = (v: number) => Math.min(1, Math.max(0, v));

/** Points along a cubic Bézier. */
function cubic(p0: Pt, p1: Pt, p2: Pt, p3: Pt, steps = 24): Pt[] {
	const out: Pt[] = [];
	for (let i = 0; i <= steps; i++) {
		const t = i / steps, u = 1 - t;
		const a = u * u * u, b = 3 * u * u * t, c = 3 * u * t * t, d = t * t * t;
		out.push([a * p0[0] + b * p1[0] + c * p2[0] + d * p3[0], a * p0[1] + b * p1[1] + c * p2[1] + d * p3[1]]);
	}
	return out;
}

let cells = '';
let extra = '';

if (name === 'parametric-grid') {
	// hexes scaled by their distance to the nearest of a point and a curve, small at the attractors
	const point: Pt = [104, 104];
	const curve = [...cubic([198, 18], [214, 58], [236, 84], [258, 98]), ...cubic([258, 98], [280, 112], [290, 136], [298, 164])];
	const reach = 74;
	const s = 11.5;
	cells = hexCentres(s, 18, 12, 302, 168)
		.map((c) => {
			const d = Math.min(Math.hypot(c[0] - point[0], c[1] - point[1]), ...curve.map((q) => Math.hypot(c[0] - q[0], c[1] - q[1])));
			const f = 0.14 + 0.78 * clamp01(d / reach);
			return hexPath(c, s * f);
		})
		.join('');
	extra = `M198 18C214 58 236 84 258 98S290 136 298 164`;
}

if (name === 'image-grid') {
	// circles on a hex lattice, each sized by how dark a lit sphere and its shadow are there, as a halftone
	const s = 7.4, inr = (SQRT3 / 2) * s;
	const L = [-0.52, -0.62, 0.59];
	const dark = ([x, y]: Pt) => {
		const cx = 132, cy = 82, R = 64;
		const dx = (x - cx) / R, dy = (y - cy) / R, rr = dx * dx + dy * dy;
		if (rr < 1) {
			const nz = Math.sqrt(1 - rr);
			const lambert = Math.max(0, dx * L[0] + dy * L[1] + nz * L[2]);
			return 1 - (0.04 + 0.96 * Math.pow(lambert, 1.3));
		}
		const sx = (x - 178) / 86, sy = (y - 152) / 14;
		const shadow = clamp01(1 - sx * sx - sy * sy) * 0.75;
		return Math.max(shadow, 0.04 + 0.08 * (y / 180));
	};
	cells = hexCentres(s, 14, 8, 306, 172)
		.map((c) => {
			const r = inr * (0.08 + 0.88 * dark(c));
			return r < 0.8 ? '' : circlePath(c, r);
		})
		.join('');
}

if (name === 'alexandria-phoenix') {
	// a region of squares scaled by a remap, the end of a small definition
	const n = 5, x0 = 214, y0 = 46, size = 88, cell = size / n;
	const out: string[] = [];
	for (let i = 0; i < n; i++)
		for (let j = 0; j < n; j++) {
			const f = 0.22 + 0.7 * clamp01((i + j) / (2 * (n - 1)));
			const c: Pt = [x0 + (i + 0.5) * cell, y0 + (j + 0.5) * cell], h = (cell * f) / 2;
			out.push(`M${r1(c[0] - h)} ${r1(c[1] - h)}h${r1(2 * h)}v${r1(2 * h)}h${r1(-2 * h)}z`);
		}
	cells = out.join('');
}

let pixels = '';
if (name === 'vectorizer') {
	// a ring as pixels, then as two clean circles
	const out: string[] = [];
	const p = 8, cx = 82, cy = 90;
	for (let x = cx - 56; x < cx + 56; x += p)
		for (let y = cy - 56; y < cy + 56; y += p) {
			const d = Math.hypot(x + p / 2 - cx, y + p / 2 - cy);
			if (d <= 46 && d >= 20) out.push(`M${x} ${y}h${p}v${p}h${-p}z`);
		}
	pixels = out.join('');
}

// braille: SIGN in Grade 1 (s 2-3-4, i 2-4, g 1-2-4-5, n 1-3-4-5); dots 1-3 down the left, 4-6 down the right
const braille = [[2, 3, 4], [2, 4], [1, 2, 4, 5], [1, 3, 4, 5]];
const dotAt = (cell: number, dot: number): Pt => [100 + cell * 40 + (dot > 3 ? 16 : 0), 82 + ((dot - 1) % 3) * 16];

// etch text: a part's label in the Alexandria Etch font, drawn from the font's own strokes
const etch = etchText('P1-1', 56, 0, 112);
const etchLeft = r1((320 - etch.width) / 2);

// color library: a fan of chips about one pin
const fan = [-60, -40, -20, 0, 20, 40, 60].map((a, i) => ({ a, tone: [1, 0.82, 0.66, 0.52, 0.4, 0.28, 0.18][i] }));

// material library: slabs of different thicknesses, stacked
const slabs = (() => {
	const list = [
		{ t: 5, label: 'ACM 4 MM' },
		{ t: 8, label: 'ALUM 0.125' },
		{ t: 14, label: 'ACRYLIC 1/2"' },
		{ t: 9, label: 'PVC 6 MM' },
	];
	let y = 52;
	return list.map((s) => {
		const out = { ...s, y };
		y += s.t + 18;
		return out;
	});
})();
